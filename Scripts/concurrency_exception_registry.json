{
  "schema_version": 1,
  "required_fields": ["category", "system_type", "protection", "replacement_plan"],
  "category_definitions": {
    "SYSTEM_WRAPPER": {
      "system_type": "PhotoKit, AVFoundation, Vision, CoreNFC, URLProtocol or Operation framework object",
      "protection": "The wrapper owns only the framework object crossing the callback boundary; mutable state stays local to the framework queue or an explicit lock.",
      "replacement_plan": "Replace the wrapper with a framework snapshot or actor-backed adapter when the minimum deployment and SDK APIs allow it."
    },
    "LOCK_PROTECTED": {
      "system_type": "Reference type with shared transport, cache, socket or speech state",
      "protection": "Every mutable field crossing an isolation boundary is accessed through the type's lock or serial queue.",
      "replacement_plan": "Move shared state to an actor or an immutable instance configuration during the 5.x migration window."
    },
    "LEGACY_MODEL": {
      "system_type": "Existing public reference model or third-party data-source class",
      "protection": "The object remains on its existing owner/actor; only immutable snapshots cross an isolation boundary.",
      "replacement_plan": "Add a Sendable value snapshot and migrate new APIs before removing the reference model in 6.0."
    },
    "MAIN_ACTOR_ONLY": {
      "system_type": "UIKit, debug UI, lifecycle, metric or proxy object",
      "protection": "Creation, mutation and callbacks are confined to MainActor; background work returns values only.",
      "replacement_plan": "Keep UI state MainActor-isolated and remove the compatibility marker after all callbacks are actor-aware."
    },
    "TEMPORARY": {
      "system_type": "Unclassified compatibility boundary",
      "protection": "No new usage is allowed; the existing call path is isolated and documented before use.",
      "replacement_plan": "Assign a concrete system, lock, model or MainActor category before the next release."
    }
  },
